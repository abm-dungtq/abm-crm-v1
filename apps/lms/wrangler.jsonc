{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abm-lms",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Secrets CONTENT_SIGNING_SECRET, STREAM_SIGNING_KEY_ID, STREAM_SIGNING_JWK are set in phase 08.
    "LMS_CONTENT_ORIGIN": "https://abm-lms-content.ngulongyquan.workers.dev",
    "STREAM_CUSTOMER_CODE": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abm-crm-eval",
      "database_id": "ecf247ae-bb5e-431a-85a1-bca9b21f7507"
    }
  ],
  "observability": { "enabled": true }
}
