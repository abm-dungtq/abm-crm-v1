{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abm-crm-eval",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Email + password sign-in (docs/adr/adr-006-password-login.md). The demo user picker
    // (DEMO_MODE=1) is for tests and local runs only and is off whenever AUTH_MODE is set.
    "AUTH_MODE": "password",
    // Base of links in inbox Lark notices; cron runs have no request origin to fall back on.
    "APP_URL": "https://abm-crm-eval.ngulongyquan.workers.dev",
    // Filled in phase 08 when LMS content Worker and Cloudflare Stream are provisioned.
    "LMS_CONTENT_ORIGIN": "https://abm-lms-content.ngulongyquan.workers.dev",
    "STREAM_ACCOUNT_ID": "",
    // Handoff check on customer turns (src/worker/inbox/decision-layer.ts): off | shadow | active.
    // Every check is logged to audit_log ('inbox.handoffCheck'); shadow only logs. TYPESAFE_API_KEY is a secret.
    "HANDOFF_NET_MODE": "active",
    "JEV_INTENT_MODE": "active",
    "JEV_CONFIDENCE": "0.75",
    "JEV_MODEL": "jev-1.13.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abm-crm-eval",
      "database_id": "ecf247ae-bb5e-431a-85a1-bca9b21f7507",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "abm-crm-media" },
    { "binding": "LMS_CONTENT", "bucket_name": "abm-lms-content" }
  ],
  // Every minute: worker commands, inbox SLA reminders and stuck outgoing messages.
  // 0 14 * * * = 14:00 UTC = 21:00 Vietnam time, for the daily group summaries.
  "triggers": { "crons": ["* * * * *", "0 14 * * *"] },
  "observability": { "enabled": true }
}
